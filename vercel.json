{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "rk-electricals-website.vercel.app" }],
      "destination": "https://rkelectricals.online/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/:path*", "destination": "/spa.html" },
    { "source": "/:path*", "destination": "/:path*/index.html" }
  ]
}
