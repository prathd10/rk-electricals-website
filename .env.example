# Copy this file to .env and fill in your credentials

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ImageKit
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
VITE_IMAGEKIT_PUBLIC_KEY=your-public-key-here

# Admin (set this to the email you'll use for login)
# Create this user via Supabase Dashboard → Authentication → Users
VITE_ADMIN_EMAIL=admin@rkelectricals.com
