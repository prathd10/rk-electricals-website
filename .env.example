# ================================================================
# R.K. ELECTRICALS — DEVELOPMENT ENVIRONMENT TEMPLATE (.env.example)
# ================================================================

# --- Supabase Configuration ---
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- ImageKit Client-Side Configuration ---
# Found in: ImageKit Dashboard → Developer Options
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
VITE_IMAGEKIT_PUBLIC_KEY=your-public-key-here
VITE_IMAGEKIT_PRIVATE_KEY=your-private-key-here

# ================================================================
# SECURE BACKEND INSTRUCTIONS
# ================================================================
# To authorize client-side image uploads securely, the app uses a Supabase
# Edge Function ('imagekit-auth').
#
# Once you install the Supabase CLI, run this to upload the Private Key:
#   supabase secrets set IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
#
# Then deploy the edge function using:
#   supabase functions deploy imagekit-auth
# ================================================================
